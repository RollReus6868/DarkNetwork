# Copy to .env.local for local work. On Cloudflare Pages set the same names under
# Settings > Environment variables. Both values are public by design (the browser needs them).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# set to true only after Google sign-in is configured in Supabase
VITE_GOOGLE_LOGIN=false
