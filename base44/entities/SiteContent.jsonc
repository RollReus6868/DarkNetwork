{
  "name": "SiteContent",
  "type": "object",
  "properties": {
    "section_key": {
      "type": "string",
      "title": "Section Key",
      "description": "Unique identifier for this section (e.g. 'video_library')"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "cta_label": {
      "type": "string",
      "title": "CTA Label"
    },
    "cta_url": {
      "type": "string",
      "title": "CTA URL"
    }
  },
  "required": [
    "section_key",
    "title",
    "description"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}