{
  "name": "Product",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "slug": {
      "type": "string",
      "title": "URL Slug"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "Apparel",
        "Wall Art",
        "Mugs",
        "Gifts",
        "Books"
      ],
      "default": "Apparel"
    },
    "price": {
      "type": "number",
      "title": "Price (USD)",
      "default": 0
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Product Images"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "format": "richtext"
    },
    "bible_inspiration": {
      "type": "string",
      "title": "Bible Inspiration",
      "format": "richtext"
    },
    "story_behind_design": {
      "type": "string",
      "title": "Story Behind the Design",
      "format": "richtext"
    },
    "product_info": {
      "type": "string",
      "title": "Product Information",
      "format": "richtext"
    },
    "size_info": {
      "type": "string",
      "title": "Size Information",
      "format": "richtext"
    },
    "shipping_info": {
      "type": "string",
      "title": "Shipping Information",
      "format": "richtext"
    },
    "spring_url": {
      "type": "string",
      "title": "Spring Product URL",
      "format": "url"
    },
    "related_study_id": {
      "type": "string",
      "title": "Related Bible Study ID"
    },
    "related_ebook_id": {
      "type": "string",
      "title": "Related Ebook ID"
    },
    "seo_title": {
      "type": "string",
      "title": "SEO Title"
    },
    "meta_description": {
      "type": "string",
      "title": "Meta Description"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "published",
        "draft"
      ],
      "default": "published"
    },
    "featured": {
      "type": "boolean",
      "title": "Featured on Homepage",
      "default": false
    }
  },
  "required": [
    "title",
    "slug",
    "category",
    "price",
    "images",
    "description",
    "spring_url"
  ]
}