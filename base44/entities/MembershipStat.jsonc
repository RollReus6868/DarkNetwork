{
  "name": "MembershipStat",
  "type": "object",
  "properties": {
    "value": {
      "type": "string",
      "title": "Stat Value",
      "description": "The displayed number/label (e.g. '19', '200+', '66')"
    },
    "label": {
      "type": "string",
      "title": "Stat Label",
      "description": "The caption under the value (e.g. 'Video Courses')"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000,
      "description": "Optional supporting text shown with this statistic."
    }
  },
  "required": [
    "value",
    "label"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}