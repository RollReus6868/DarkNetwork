{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "slug": {
      "type": "string",
      "title": "URL Slug"
    },
    "excerpt": {
      "type": "string",
      "title": "Excerpt"
    },
    "content": {
      "type": "string",
      "title": "Content",
      "format": "richtext"
    },
    "hero_image": {
      "type": "string",
      "title": "Hero Image URL",
      "format": "url"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "seo_title": {
      "type": "string",
      "title": "SEO Title"
    },
    "meta_description": {
      "type": "string",
      "title": "Meta Description"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "published",
        "draft"
      ],
      "default": "published"
    }
  },
  "required": [
    "title",
    "slug",
    "excerpt",
    "content",
    "hero_image"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
