{
  "name": "Ebook",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "slug": {
      "type": "string",
      "title": "URL Slug"
    },
    "subtitle": {
      "type": "string",
      "title": "Subtitle"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "format": "richtext"
    },
    "price": {
      "type": "number",
      "title": "Price (USD)",
      "default": 0
    },
    "original_price": {
      "type": "number",
      "title": "Original Price (USD)",
      "description": "Optional. If set and greater than price, a crossed-out original price and SALE badge with the real discount percentage are shown. If empty, no discount is displayed."
    },
    "cover_image": {
      "type": "string",
      "title": "Cover Image URL",
      "format": "url"
    },
    "what_you_learn": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "What You Will Learn"
    },
    "preview_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Preview Page Images"
    },
    "who_for": {
      "type": "string",
      "title": "Who This Book Is For",
      "format": "richtext"
    },
    "file_url": {
      "type": "string",
      "title": "Downloadable File URL",
      "format": "url",
      "description": "Public download URL \u2014 do NOT use this for paid ebooks. Use secure_file_uri instead."
    },
    "secure_file_uri": {
      "type": "string",
      "title": "Secure Private File URI",
      "description": "Private file URI (from UploadPrivateFile). Used for paid ebooks \u2014 downloads are gated and served via short-lived signed URLs only."
    },
    "bonus_title": {
      "type": "string",
      "title": "Bonus Gift Title",
      "description": "Name of the free mini ebook bundled with this purchase."
    },
    "bonus_description": {
      "type": "string",
      "title": "Bonus Gift Description",
      "description": "Short pitch shown with the bonus gift on the ebook page."
    },
    "bonus_cover_image": {
      "type": "string",
      "title": "Bonus Gift Cover Image URL",
      "format": "url"
    },
    "bonus_secure_file_uri": {
      "type": "string",
      "title": "Bonus Gift Private File URI",
      "description": "Private file URI (from UploadPrivateFile) for the bundled mini ebook. Downloads are gated exactly like the main file."
    },
    "lemon_squeezy_variant_id": {
      "type": "string",
      "title": "Lemon Squeezy Variant ID",
      "description": "The Lemon Squeezy variant ID for this ebook. Required for checkout. Find it in your Lemon Squeezy product dashboard."
    },
    "related_ebook_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Related Ebooks",
      "description": "Ebooks hand-picked in Admin to be recommended at the bottom of this book's page. The chosen order is the priority order. If left empty, books from the same series (same title, different Part/Book/Volume) are suggested first."
    },
    "edition_type": {
      "type": "string",
      "title": "Edition Type",
      "enum": [
        "auto",
        "full",
        "part"
      ],
      "default": "auto",
      "description": "Which homepage row this book belongs to. auto = detect from the title (a 'Part N' title is a part book); full = complete edition; part = single part of a series."
    },
    "related_video_id": {
      "type": "string",
      "title": "Related Video ID"
    },
    "related_study_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Related Bible Study IDs"
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "author": {
            "type": "string"
          },
          "rating": {
            "type": "number"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "title": "Reader Reviews"
    },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        }
      },
      "title": "FAQ"
    },
    "seo_title": {
      "type": "string",
      "title": "SEO Title"
    },
    "meta_description": {
      "type": "string",
      "title": "Meta Description"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "published",
        "draft"
      ],
      "default": "published"
    },
    "featured": {
      "type": "boolean",
      "title": "Featured on Homepage",
      "default": false
    }
  },
  "required": [
    "title",
    "slug",
    "description",
    "price",
    "cover_image"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}