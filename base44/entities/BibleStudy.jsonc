{
  "name": "BibleStudy",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "slug": {
      "type": "string",
      "title": "URL Slug"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "Old Testament",
        "New Testament",
        "Bible Prophecy",
        "Biblical History",
        "Biblical Mysteries",
        "People of the Bible"
      ],
      "default": "Old Testament"
    },
    "excerpt": {
      "type": "string",
      "title": "Short Excerpt"
    },
    "content": {
      "type": "string",
      "title": "Article Content",
      "format": "richtext"
    },
    "hero_image": {
      "type": "string",
      "title": "Hero Image URL",
      "format": "url"
    },
    "bible_verses": {
      "type": "string",
      "title": "Bible Verses",
      "format": "richtext"
    },
    "historical_context": {
      "type": "string",
      "title": "Historical Context",
      "format": "richtext"
    },
    "conclusion": {
      "type": "string",
      "title": "Conclusion",
      "format": "richtext"
    },
    "related_video_id": {
      "type": "string",
      "title": "Related Video ID"
    },
    "related_ebook_id": {
      "type": "string",
      "title": "Related Ebook ID"
    },
    "related_product_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Related Product IDs"
    },
    "seo_title": {
      "type": "string",
      "title": "SEO Title"
    },
    "meta_description": {
      "type": "string",
      "title": "Meta Description"
    },
    "og_image": {
      "type": "string",
      "title": "Social Share Image URL",
      "format": "url"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "published",
        "draft"
      ],
      "default": "published"
    },
    "featured": {
      "type": "boolean",
      "title": "Featured on Homepage",
      "default": false
    }
  },
  "required": [
    "title",
    "slug",
    "category",
    "excerpt",
    "content",
    "hero_image"
  ]
}