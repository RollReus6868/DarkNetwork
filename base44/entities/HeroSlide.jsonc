{
  "name": "HeroSlide",
  "type": "object",
  "properties": {
    "image": {
      "type": "string",
      "title": "Background Image URL",
      "format": "url"
    },
    "eyebrow": {
      "type": "string",
      "title": "Eyebrow Text"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "cta1_label": {
      "type": "string",
      "title": "Primary Button Label"
    },
    "cta1_url": {
      "type": "string",
      "title": "Primary Button URL"
    },
    "cta2_label": {
      "type": "string",
      "title": "Secondary Button Label"
    },
    "cta2_url": {
      "type": "string",
      "title": "Secondary Button URL"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "published",
        "draft"
      ],
      "default": "published"
    }
  },
  "required": [
    "image",
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}