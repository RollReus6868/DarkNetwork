{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "rating": {
      "type": "number",
      "title": "Rating (1-5)",
      "minimum": 1,
      "maximum": 5,
      "default": 5
    },
    "text": {
      "type": "string",
      "title": "Review Text",
      "format": "richtext"
    },
    "author": {
      "type": "string",
      "title": "Author Name"
    },
    "location": {
      "type": "string",
      "title": "Author Location"
    },
    "verified": {
      "type": "boolean",
      "title": "Verified Buyer",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "rating",
    "text",
    "author"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}